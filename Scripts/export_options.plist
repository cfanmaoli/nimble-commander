<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Used by build_release.sh / build_nightly.sh for signed packaging only. The app itself is signed
     by the archive/export with the NonMAS configuration's identity (currently the maintainer's
     Apple Development certificate of team 359W39ZS37). A development export needs no provisioning
     profile; for a notarised public release switch the project to a Developer ID Application
     certificate and use NC_EXPORT_OPTIONS with method=developer-id instead. -->
<plist version="1.0">
<dict>
	<key>method</key>
	<string>development</string>
	<key>embedOnDemandResourcesAssetPacksInBundle</key>
	<false/>
	<key>compileBitcode</key>
	<false/>
	<key>destination</key>
	<string>export</string>
</dict>
</plist>
