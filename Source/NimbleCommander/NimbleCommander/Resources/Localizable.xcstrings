          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "平铺视图会跳过云同步目录（Library/CloudStorage 与 Library/Mobile Documents），因此不显示其中的内容。可以在设置项 filePanel.general.flatViewSkipCloudStorage 中修改此行为。"
