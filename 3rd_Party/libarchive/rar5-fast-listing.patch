diff --git a/libarchive/archive_read_support_format_rar5.c b/libarchive/archive_read_support_format_rar5.c
--- a/libarchive/archive_read_support_format_rar5.c
+++ b/libarchive/archive_read_support_format_rar5.c
@@ -332,6 +332,12 @@
 /* Main context structure. */
 struct rar5 {
 	int header_initialized;
+
+	/* When set, the data of solid files will be skipped instead of being
+	 * decompressed during a header walk. This is only valid for reading
+	 * the entry list - the window state won't be maintained - so the
+	 * caller must not extract anything from such a handle. */
+	int skip_solid_data;
 
 	/* Set to 1 if current file is positioned AFTER the magic value
 	 * of the archive file. This is used in header reading functions. */
@@ -1219,13 +1225,17 @@
 
 static int rar5_options(struct archive_read *a, const char *key,
     const char *val) {
-	(void) a;
-	(void) key;
+	struct rar5 *rar5 = (struct rar5 *) a->format->data;
+
+	if (strcmp(key, "skip_solid_data") == 0) {
+		rar5->skip_solid_data = (val != NULL && strcmp(val, "1") == 0);
+		return ARCHIVE_OK;
+	}
+
 	(void) val;
 
-	/* No options supported in this version. Return the ARCHIVE_WARN code
-	 * to signal the options supervisor that the unpacker didn't handle
-	 * setting this option. */
+	/* Unknown option. Return the ARCHIVE_WARN code to signal the options
+	 * supervisor that the unpacker didn't handle setting this option. */
 
 	return ARCHIVE_WARN;
 }
@@ -4526,7 +4536,7 @@
 static int rar5_read_data_skip(struct archive_read *a) {
 	struct rar5 *rar5 = a->format->data;
 
-	if(rar5->main.solid && (rar5->cstate.data_encrypted == 0)) {
+	if(rar5->main.solid && !rar5->skip_solid_data && (rar5->cstate.data_encrypted == 0)) {
 		/* In solid archives, instead of skipping the data, we need to
 		 * extract it, and dispose the result. The side effect of this
 		 * operation will be setting up the initial window buffer state
@@ -4572,6 +4582,24 @@
 		}
 
 		rar5->file.bytes_remaining = 0;
+
+		/* When skipping solid data, no decompression took place, so the
+		 * window buffer was never allocated. Allocate it here (with
+		 * zeroes, its content is never used in this mode) so that the
+		 * next file header, which declares itself as solid, passes the
+		 * "window buffer initialized" sanity check. */
+		if(rar5->skip_solid_data && rar5->main.solid &&
+		    rar5->cstate.window_buf == NULL && rar5->cstate.window_size > 0) {
+			rar5->cstate.window_buf =
+			    calloc(1, (size_t) rar5->cstate.window_size);
+			if(rar5->cstate.window_buf == NULL) {
+				archive_set_error(&a->archive,
+				    ARCHIVE_ERRNO_PROGRAMMER,
+				    "Not enough memory when trying to allocate the "
+				    "window buffer");
+				return ARCHIVE_FATAL;
+			}
+		}
 	}
 
 	return ARCHIVE_OK;
